# ================================================================
# DormBook — Environment Variables for Railway
# ================================================================
# Set ALL of these in Railway → your service → Variables tab.
# DO NOT commit a .env file with real values to git.
# ================================================================

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production

# Railway injects PORT automatically — do NOT set this manually
# PORT=3000

# ── Database ──────────────────────────────────────────────────
# Add a Railway Volume and mount it at /data
# The app writes the SQLite file to /data/dormbook.db automatically.
# If no volume is added, the DB resets on every redeploy (demo only).
#
# DB_DIR=/data        ← default, matches Railway volume mount path
# DB_PATH=/data/dormbook.db  ← override if needed

# ── Authentication ────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48

JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ── Encryption (AES-256-GCM for Aadhaar PII) ─────────────────
# REQUIRED — generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (= 32 bytes)
AES_256_KEY=CHANGE_ME_use_openssl_rand_hex_32

# ── Auto-seed (first deploy only) ────────────────────────────
# These are used ONCE when the DB is empty (first Railway deploy).
# Change the password immediately after first login.
SEED_OWNER_EMAIL=owner@yourpg.in
SEED_OWNER_PASSWORD=ChangeMe@123!
SEED_OWNER_MOBILE=9876543210
SEED_OWNER_NAME=Property Owner
SEED_PROPERTY_NAME=My PG Name
SEED_PROPERTY_CODE=PROP

# ── WhatsApp ─────────────────────────────────────────────────
# Provider: 'meta' (Graph API) or '360dialog'
WHATSAPP_PROVIDER=360dialog
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
# For Meta provider only:
# WHATSAPP_PHONE_ID=your_meta_waba_phone_number_id
# WHATSAPP_NAMESPACE=your_template_namespace

# ── CORS ─────────────────────────────────────────────────────
# Only needed if frontend is on a SEPARATE domain from the API.
# If frontend and API are on the same Railway service, leave blank.
# ALLOWED_ORIGINS=https://yourapp.railway.app

# ── Cron & Webhooks ───────────────────────────────────────────
CRON_SECRET=CHANGE_ME_use_openssl_rand_hex_16
WEBHOOK_SECRET=CHANGE_ME_use_openssl_rand_hex_16
DISABLE_SCHEDULER=false
